//@version=6
indicator("EWZ GEX → WIN · Export V2", overlay = true, max_labels_count = 100)

// ============================================================================
// 1) BLOCO GERADO PELO GAMMA EXPOSURE
//    O bloco contém níveis EWZ e os níveis WIN já projetados pela aplicação.
// ============================================================================
groupBridge = "1. Gamma Exposure App"
inputMode = input.string("Bloco EWZGEX2", "Origem dos níveis", options = ["Bloco EWZGEX2", "Manual"], group = groupBridge)
appBlock = input.text_area("", "Bloco EWZGEX2", group = groupBridge, tooltip = "Cole aqui o bloco gerado pela página TradingView do Gamma Exposure. Os níveis WIN já vêm projetados pela aplicação.")

bool blockOk = str.startswith(appBlock, "EWZGEX2|")

f_blockFloat(string key, float fallback) =>
    float out = fallback
    if blockOk
        parts = str.split(appBlock, "|")
        for i = 0 to array.size(parts) - 1
            token = array.get(parts, i)
            kv = str.split(token, "=")
            if array.size(kv) >= 2 and array.get(kv, 0) == key
                parsed = str.tonumber(array.get(kv, 1))
                if not na(parsed)
                    out := parsed
    out

f_blockString(string key, string fallback) =>
    string out = fallback
    if blockOk
        parts = str.split(appBlock, "|")
        for i = 0 to array.size(parts) - 1
            token = array.get(parts, i)
            kv = str.split(token, "=")
            if array.size(kv) >= 2 and array.get(kv, 0) == key
                out := array.get(kv, 1)
    out

// ============================================================================
// 2) FALLBACK MANUAL — NÍVEIS JÁ PROJETADOS EM PONTOS DE WIN
// ============================================================================
groupManual = "2. Níveis WIN manuais"
spotManual = input.float(0.0, "Spot projetado", minval = 0.0, step = 5.0, group = groupManual)
callWallManual = input.float(0.0, "Call Wall", minval = 0.0, step = 5.0, group = groupManual)
putWallManual = input.float(0.0, "Put Wall", minval = 0.0, step = 5.0, group = groupManual)
flipManual = input.float(0.0, "Gamma Flip", minval = 0.0, step = 5.0, group = groupManual)
maxGexManual = input.float(0.0, "Maior |GEX|", minval = 0.0, step = 5.0, group = groupManual)
maxPainManual = input.float(0.0, "Max Pain", minval = 0.0, step = 5.0, group = groupManual)
emLowManual = input.float(0.0, "Expected Move −", minval = 0.0, step = 5.0, group = groupManual)
emHighManual = input.float(0.0, "Expected Move +", minval = 0.0, step = 5.0, group = groupManual)

bool useBlock = inputMode == "Bloco EWZGEX2" and blockOk

wSpot = useBlock ? f_blockFloat("wspot", 0.0) : spotManual
wCallWall = useBlock ? f_blockFloat("wcw", 0.0) : callWallManual
wPutWall = useBlock ? f_blockFloat("wpw", 0.0) : putWallManual
wFlip = useBlock ? f_blockFloat("wflip", 0.0) : flipManual
wMaxGex = useBlock ? f_blockFloat("wmaxg", 0.0) : maxGexManual
wMaxPain = useBlock ? f_blockFloat("wpain", 0.0) : maxPainManual
wEmLow = useBlock ? f_blockFloat("wemlo", 0.0) : emLowManual
wEmHigh = useBlock ? f_blockFloat("wemhi", 0.0) : emHighManual

ewzSpot = useBlock ? f_blockFloat("spot", 0.0) : 0.0
ewzCallWall = useBlock ? f_blockFloat("cw", 0.0) : 0.0
ewzPutWall = useBlock ? f_blockFloat("pw", 0.0) : 0.0
ewzFlip = useBlock ? f_blockFloat("flip", 0.0) : 0.0
ewzMaxGex = useBlock ? f_blockFloat("maxg", 0.0) : 0.0
ewzMaxPain = useBlock ? f_blockFloat("pain", 0.0) : 0.0
ewzEmLow = useBlock ? f_blockFloat("emlo", 0.0) : 0.0
ewzEmHigh = useBlock ? f_blockFloat("emhi", 0.0) : 0.0

snapshotText = useBlock ? f_blockString("ts", "—") : "manual"
scopeText = useBlock ? f_blockString("scope", "—") : "manual"
ratioText = useBlock ? f_blockString("ratio", "—") : "manual"
ratioTimeText = useBlock ? f_blockString("ratiots", "—") : "manual"

// ============================================================================
// 3) VISUAL
// ============================================================================
groupVisual = "3. Visual"
showSpot = input.bool(true, "Spot projetado", group = groupVisual)
showCallWall = input.bool(true, "Call Wall", group = groupVisual)
showPutWall = input.bool(true, "Put Wall", group = groupVisual)
showFlip = input.bool(true, "Gamma Flip", group = groupVisual)
showMaxGex = input.bool(true, "Maior |GEX|", group = groupVisual)
showMaxPain = input.bool(true, "Max Pain", group = groupVisual)
showExpectedMove = input.bool(true, "Expected Move ±", group = groupVisual)
showFlipRegime = input.bool(true, "Destacar acima/abaixo do Gamma Flip", group = groupVisual)
showLabels = input.bool(true, "Mostrar rótulos", group = groupVisual)
showTable = input.bool(true, "Mostrar painel", group = groupVisual)
labelOffset = input.int(2, "Deslocamento dos rótulos", minval = 0, maxval = 50, group = groupVisual)
recentOnly = input.bool(true, "Exibir somente barras recentes", group = groupVisual, tooltip = "Evita a impressão de que os níveis do snapshot atual existiam em todo o histórico.")
recentDays = input.int(3, "Dias corridos exibidos", minval = 1, maxval = 30, group = groupVisual)

bool inWindow = not recentOnly or time >= timenow - recentDays * 24 * 60 * 60 * 1000
f_valid(float x) => not na(x) and x > 0
f_level(bool enabled, float x) => enabled and inWindow and f_valid(x) ? x : na

lSpot = f_level(showSpot, wSpot)
lCallWall = f_level(showCallWall, wCallWall)
lPutWall = f_level(showPutWall, wPutWall)
lFlip = f_level(showFlip, wFlip)
lMaxGex = f_level(showMaxGex, wMaxGex)
lMaxPain = f_level(showMaxPain, wMaxPain)
lEmLow = f_level(showExpectedMove, wEmLow)
lEmHigh = f_level(showExpectedMove, wEmHigh)

plot(lSpot, "WIN · Spot projetado", color = color.new(color.gray, 20), linewidth = 1, style = plot.style_linebr)
plot(lCallWall, "WIN · Call Wall", color = color.orange, linewidth = 3, style = plot.style_linebr)
plot(lPutWall, "WIN · Put Wall", color = color.green, linewidth = 3, style = plot.style_linebr)
plot(lFlip, "WIN · Gamma Flip", color = color.yellow, linewidth = 3, style = plot.style_linebr)
plot(lMaxGex, "WIN · Maior |GEX|", color = color.aqua, linewidth = 2, style = plot.style_linebr)
plot(lMaxPain, "WIN · Max Pain", color = color.fuchsia, linewidth = 2, style = plot.style_linebr)
plot(lEmLow, "WIN · Expected Move −", color = color.new(color.blue, 25), linewidth = 2, style = plot.style_linebr)
plot(lEmHigh, "WIN · Expected Move +", color = color.new(color.blue, 25), linewidth = 2, style = plot.style_linebr)

bgcolor(showFlipRegime and not na(lFlip) ? close >= lFlip ? color.new(color.green, 93) : color.new(color.red, 93) : na, title = "Regime relativo ao Gamma Flip projetado")
chartIsWin = str.contains(str.upper(syminfo.ticker), "WIN")
bgcolor(not chartIsWin ? color.new(color.orange, 92) : na, title = "Aviso: gráfico diferente de WIN")

// ============================================================================
// 4) RÓTULOS
// ============================================================================
f_label(label id, float y, float ewz, string name, color c) =>
    label out = id
    if barstate.islast
        if showLabels and not na(y)
            string ewzTxt = f_valid(ewz) ? " · EWZ " + str.tostring(ewz, "#.##") : ""
            string txt = name + " · WIN " + str.tostring(y, format.mintick) + ewzTxt
            if na(out)
                out := label.new(bar_index + labelOffset, y, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(c, 10), textcolor = color.white, size = size.small)
            else
                label.set_xy(out, bar_index + labelOffset, y)
                label.set_text(out, txt)
                label.set_color(out, color.new(c, 10))
                label.set_textcolor(out, color.white)
        else
            if not na(out)
                label.delete(out)
            out := na
    out

var label lbSpot = na
var label lbCw = na
var label lbPw = na
var label lbFlip = na
var label lbMax = na
var label lbPain = na
var label lbLo = na
var label lbHi = na

lbSpot := f_label(lbSpot, lSpot, ewzSpot, "Spot", color.gray)
lbCw := f_label(lbCw, lCallWall, ewzCallWall, "Call Wall", color.orange)
lbPw := f_label(lbPw, lPutWall, ewzPutWall, "Put Wall", color.green)
lbFlip := f_label(lbFlip, lFlip, ewzFlip, "Gamma Flip", color.yellow)
lbMax := f_label(lbMax, lMaxGex, ewzMaxGex, "Maior |GEX|", color.aqua)
lbPain := f_label(lbPain, lMaxPain, ewzMaxPain, "Max Pain", color.fuchsia)
lbLo := f_label(lbLo, lEmLow, ewzEmLow, "Expected Move −", color.blue)
lbHi := f_label(lbHi, lEmHigh, ewzEmHigh, "Expected Move +", color.blue)

// ============================================================================
// 5) PAINEL
// ============================================================================
f_fmtWin(float x) => f_valid(x) ? str.tostring(x, format.mintick) : "—"
f_fmtEwz(float x) => f_valid(x) ? str.tostring(x, "#.##") : "—"
f_dist(float x) => f_valid(x) ? str.tostring((close / x - 1.0) * 100.0, "#.##") + "%" : "—"

var table panel = table.new(position.top_right, 4, 12, border_width = 1)
f_row(int row, string name, float ewz, float win, color c) =>
    table.cell(panel, 0, row, name, text_color = c)
    table.cell(panel, 1, row, f_fmtEwz(ewz))
    table.cell(panel, 2, row, f_fmtWin(win))
    table.cell(panel, 3, row, f_dist(win))

if barstate.islast
    table.clear(panel, 0, 0, 3, 11)
    if showTable
        table.cell(panel, 0, 0, "EWZGEX2")
        table.cell(panel, 1, 0, blockOk ? "OK" : "manual")
        table.cell(panel, 2, 0, scopeText)
        table.cell(panel, 3, 0, ratioText)
        table.cell(panel, 0, 1, "Snapshot")
        table.cell(panel, 1, 1, snapshotText)
        table.cell(panel, 2, 1, "Ref. razão")
        table.cell(panel, 3, 1, ratioTimeText)
        table.cell(panel, 0, 2, "Nível")
        table.cell(panel, 1, 2, "EWZ")
        table.cell(panel, 2, 2, "WIN")
        table.cell(panel, 3, 2, "Dist. atual")
        f_row(3, "Spot", ewzSpot, wSpot, color.gray)
        f_row(4, "Call Wall", ewzCallWall, wCallWall, color.orange)
        f_row(5, "Put Wall", ewzPutWall, wPutWall, color.green)
        f_row(6, "Gamma Flip", ewzFlip, wFlip, color.yellow)
        f_row(7, "Maior |GEX|", ewzMaxGex, wMaxGex, color.aqua)
        f_row(8, "Max Pain", ewzMaxPain, wMaxPain, color.fuchsia)
        f_row(9, "Expected −", ewzEmLow, wEmLow, color.blue)
        f_row(10, "Expected +", ewzEmHigh, wEmHigh, color.blue)
        table.cell(panel, 0, 11, "Fonte")
        table.cell(panel, 1, 11, "Gamma Exposure")
        table.cell(panel, 2, 11, "projeção pronta")
        table.cell(panel, 3, 11, "tick WIN")

// ============================================================================
// 6) ALERTAS
// ============================================================================
groupAlerts = "4. Alertas"
proximityPct = input.float(0.10, "Zona de proximidade (%)", minval = 0.01, maxval = 5.0, step = 0.01, group = groupAlerts)
f_near(float level) => not na(level) and math.abs(close / level - 1.0) * 100.0 <= proximityPct

nearAny = f_near(lCallWall) or f_near(lPutWall) or f_near(lFlip) or f_near(lMaxGex) or f_near(lMaxPain) or f_near(lEmLow) or f_near(lEmHigh)
alertcondition(nearAny and not nearAny[1], "WIN próximo de nível GEX", "O WIN entrou na zona de proximidade de um nível GEX exportado pelo Gamma Exposure.")
alertcondition(ta.cross(close, lCallWall), "WIN cruzou Call Wall", "O WIN cruzou a Call Wall projetada.")
alertcondition(ta.cross(close, lPutWall), "WIN cruzou Put Wall", "O WIN cruzou a Put Wall projetada.")
alertcondition(ta.cross(close, lFlip), "WIN cruzou Gamma Flip", "O WIN cruzou o Gamma Flip projetado.")
alertcondition(ta.cross(close, lMaxGex), "WIN cruzou maior |GEX|", "O WIN cruzou o nível de maior |GEX| projetado.")
alertcondition(ta.cross(close, lMaxPain), "WIN cruzou Max Pain", "O WIN cruzou o Max Pain projetado.")
alertcondition(ta.cross(close, lEmLow), "WIN cruzou Expected Move −", "O WIN cruzou o limite inferior do Expected Move projetado.")
alertcondition(ta.cross(close, lEmHigh), "WIN cruzou Expected Move +", "O WIN cruzou o limite superior do Expected Move projetado.")
